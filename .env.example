# Database
# Local: postgresql://user:password@localhost:5432/taekwondo_db
# Production (Neon): postgresql://user:password@ep-xxx.neon.tech/taekwondo_db?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/taekwondo_db?schema=public"

# NextAuth Configuration
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
# Use different secrets for local and production!
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# App Configuration
NODE_ENV="development"

# Optional: For production debugging
# NEXTAUTH_DEBUG=true